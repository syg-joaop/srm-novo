{
  "name": "medtempo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Acompanhe seus horários de dose e descubra quando suas medicações começam a fazer efeito.",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
